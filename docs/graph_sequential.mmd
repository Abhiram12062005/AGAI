---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	diagnoser(diagnoser)
	fixer(fixer)
	tester(tester)
	pr_prepare(pr_prepare)
	open_pr(open_pr<hr/><small><em>__interrupt = before</em></small>)
	escalate(escalate)
	__end__([<p>__end__</p>]):::last
	__start__ --> diagnoser;
	diagnoser -.-> escalate;
	diagnoser -.-> fixer;
	fixer --> tester;
	pr_prepare --> open_pr;
	tester -.-> diagnoser;
	tester -.-> escalate;
	tester -.-> pr_prepare;
	escalate --> __end__;
	open_pr --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
