# Copy to .env and fill in. .env is git-ignored and blocklisted from every agent tool.
GEMINI_API_KEY=

# Optional: lets the PR agent open pull requests via PyGithub (otherwise the gh CLI is used
# if installed, otherwise you get a compare URL after the branch is pushed).
GITHUB_TOKEN=

# Optional: LangSmith export of LangGraph runs + every model call.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=codefix-ai

# Optional: embedder for RAG. minilm (default, sentence-transformers all-MiniLM-L6-v2) | hash (no download)
CODEFIX_EMBEDDER=minilm
